[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = req_ext

[dn]
C = ID
ST = Indonesia
L = Jakarta
O = IndoLens
OU = Development
CN = 192.168.20.212

[req_ext]
subjectAltName = @alt_names

[alt_names]
IP.1 = 192.168.20.212
IP.2 = 127.0.0.1
DNS.1 = localhost
DNS.2 = indolens.test
